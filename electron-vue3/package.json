{
  "name": "badcase-doctor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "predev": "node scripts/check-terminal-deps.mjs",
    "dev": "vite",
    "dev:force": "vite --force",
    "prebuild": "node scripts/check-terminal-deps.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "electron:dev": "vite & electron .",
    "postinstall": "electron-builder install-app-deps",
    "electron:build": "vite build && electron-builder install-app-deps && electron-builder --win nsis",
    "electron:build:dir": "vite build && electron-builder install-app-deps && electron-builder --win dir"
  },
  "build": {
    "appId": "com.badcasedoctor.app",
    "productName": "BadCase Doctor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-clipboard": "0.3.0-beta.197",
    "@xterm/addon-fit": "0.12.0-beta.197",
    "@xterm/addon-search": "^0.17.0-beta.197",
    "@xterm/addon-serialize": "^0.15.0-beta.197",
    "@xterm/addon-unicode11": "0.10.0-beta.197",
    "@xterm/addon-webgl": "0.20.0-beta.196",
    "@xterm/xterm": "6.1.0-beta.197",
    "axios": "^1.6.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.0",
    "bootstrap-vue-next": "^0.30.4",
    "esbuild": "^0.27.4",
    "json-bigint": "^1.0.0",
    "marked": "^17.0.4",
    "monaco-editor": "^0.54.0",
    "node-pty": "^1.0.0",
    "vue": "^3.4.0",
    "vue-advanced-chat": "^2.1.0",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.2.0",
    "vue3-tiptap-editor": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~5.7.2",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
