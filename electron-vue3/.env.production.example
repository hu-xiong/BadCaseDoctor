# Copy to .env.production before: npm run electron:build
# Local packaged desktop talking to local API:
VITE_BACKEND_URL=http://127.0.0.1:5000
# Cloud SaaS:
# VITE_BACKEND_URL=https://api.example.com
# Show demo account hint on login (local/trial builds only):
# VITE_SHOW_DEMO_LOGIN=1
# Optional: pass to /metrics when METRICS_TOKEN is set on server
# VITE_METRICS_TOKEN=
