# Copy to .env and fill in. Do not commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://badcasedoctor:password@127.0.0.1:3306/badcasedoctor?charset=utf8mb4
# 生产务必设置强随机 SECRET_KEY；演示账号仅本地联调开启
# SEED_DEMO_USERS=1
# SESSION_COOKIE_SECURE=1
# Prometheus /metrics 可选保护（Bearer 或 ?token=）
# METRICS_TOKEN=

# Electron 打包客户端（file:// → API）跨域登录
CORS_ALLOW_NULL_ORIGIN=1
# 纯浏览器 HTTPS 部署可改为: SESSION_COOKIE_SAMESITE=None + SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
# 浏览器 SaaS 前端源（生产必填其一：CORS_ORIGINS 或 CORS_ALLOW_NULL_ORIGIN）
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Stripe / 外链支付回跳到前端 hash 路由
# FRONTEND_BASE_URL=https://app.example.com
TRUST_PROXY=1
# WSGI_TIMEOUT=3600
# AGENT_RATE_RETRY_AFTER=60
# Go 后端 profile 必填
# JWT_SECRET=replace-with-long-random

# Server
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
PORT=5000
# WSGI_SERVER=waitress|gunicorn|flask  (default: waitress on Windows, gunicorn elsewhere)
# WSGI_THREADS=200
# WSGI_WORKERS=2
# WSGI_TIMEOUT=120
BADCASE_USE_WAITRESS=1
BADCASE_MANAGE_LOCAL_PROXY=0

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 未计划脏数据清理（grep 过滤 plan_id 为空的记录；总任务完成后经 Redis 队列异步物理删除）
# GREP_FILTER_UNPLANNED=1        grep 结果过滤未计划记录（0 关闭，回退旧行为）
# DIRTY_CLEANUP_ENABLED=1        清理总开关（0 关闭登记与消费；默认开）
# DIRTY_CLEANUP_QUEUE_KEY=badcase:dirty_cleanup:queue
# DIRTY_CLEANUP_MAX_PENDING=800  单项目登记上限（超出丢弃最旧）

# Object storage（本地填真实值；勿提交 .env）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=apaas-root
MINIO_SAAS_FILE_PATH=saas_qa_file

# Elasticsearch (grep / long memory index)
ES_URL=
ES_HOST=
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_INDEX_ENV=dev

# LLM keys
QWEN_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=

# LLM transport: native（默认，原厂 SDK）| litellm（统一传输 + fallback）
# 业务 Auto 选模仍走 llm/model_router.py，不受此开关影响
# LLM_TRANSPORT=litellm
# LITELLM_FALLBACK_MODELS=qwen3.5-plus,deepseek-v4-flash
# LITELLM_NUM_RETRIES=1
# 文心走 LiteLLM 时需 OpenAI 兼容网关：
# QIANFAN_COMPAT_BASE_URL=

# Auto 智能策略（多信号评分；写库/终端续跑禁止降到最便宜档）
# AUTO_SMART=1
# AUTO_ROUTE_DEBUG=1
# AUTO_DOWNGRADE_SIMPLE_ENABLED=1
# SIMPLE_TASK_MAX_CHARS=400


# Mail (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Billing: stripe | wechat | alipay | mock
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard → Webhooks（公网 HTTPS，勿加前端 hash）:
# https://api.example.com/api/payment/webhook
# WeChat Pay (Native) — required when PAYMENT_PROVIDER=wechat
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
# Alipay — required when PAYMENT_PROVIDER=alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# Agent billing: set AGENT_SKIP_CREDITS=1 for local free runs
AGENT_REQUIRE_CREDITS=1
AGENT_FREE_CREDITS_ON_FIRST_USE=50
# AGENT_SKIP_CREDITS=1

# Agent engine: langgraph (default) | react (legacy)
AGENT_ENGINE=langgraph
# AGENT_LANGGRAPH_MAX_ROUNDS=12
# AGENT_LANGGRAPH_TOOLS=*
# retry+replan 合计上限（耗尽后 interrupt 交还用户）
# LANGGRAPH_FAILURE_MAX_RETRIES=2
# 失败后强制 grep+补参再执行（默认开）
# LANGGRAPH_STRUCTURED_RECOVER=1
# 首轮启发式 task_plan / plan_init（默认开）
# LANGGRAPH_TASK_PLAN=1
# 工具后结构化 observe 再回 agent（默认开）
# LANGGRAPH_OBSERVE=1
# LangGraph checkpointer：sqlite（默认，落盘）| memory | off
# LANGGRAPH_CHECKPOINTER=sqlite
# LANGGRAPH_CHECKPOINT_SQLITE=data/langgraph_checkpoints.sqlite

# LangSmith tracing + offline eval
# LANGSMITH_TRACING=1
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=badcase-doctor
# LANGSMITH_ENDPOINT=
# 评测上传时允许 harness 打 trace：LANGSMITH_EVAL_ALLOW_TRACE=1
# 本地: python -m evals.langsmith.run_eval --dry-run
# 上传: python -m evals.langsmith.run_eval --upload


# Agent rate limit
AGENT_RATE_LIMIT=1
AGENT_RATE_RPM=30
AGENT_RATE_BURST=10
AGENT_MAX_CONCURRENT=2

# --- Local seed-trial recipe ---
# SEED_DEMO_USERS=1
# AGENT_SKIP_CREDITS=0
# PAYMENT_PROVIDER=mock
# AGENT_ENGINE=langgraph

# CDP testcase auto-run after navigate/login
CDP_AUTO_RUN_TESTCASE=1
# 测站/探测 explore 引擎：midscene（默认，真人式巡检）| combined（Midscene + Gremlins 猴子测试，稳定性回归时用）
#                        | auto（失败回退 legacy）| legacy（旧 DFS）
CDP_EXPLORE_ENGINE=midscene
CDP_AUTO_RUN_EXPLORE=1
# 巡检撞登录墙后等待人工登录的窗口秒数（30~600，默认 150）；
# 超时后巡检暂停，用户登录后回复「继续」可续跑
# CDP_EXPLORE_LOGIN_WAIT_SEC=150
# Midscene 模型（agents/midscene_runner；需先 npm install）
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_NAME=qwen-vl-max-latest
# MIDSCENE_MODEL_FAMILY=qwen
# MIDSCENE_SMOKE_TIMEOUT_SEC=300

# --- 本机浏览器 CDP 跨网通道（反连隧道 + 网关，见 docs/技术设计_本机浏览器CDP通道.md）---
# CDP 连接模式：auto（默认，隧道在线走本机；私网离线不降级）/ local（强制本机）/ launch（强制云端启动）
# CDP_CONNECTION_MODE=auto
# 隧道 token HMAC 密钥（必填才启用；Flask 签发 + 桥服务验签共享，建议 32 字节随机串）
# BADCASE_TUNNEL_SECRET=
# 桥服务（local_browser_bridge.py）：网关 + internal API 仅环回，隧道监听经 nginx 暴露
# BADCASE_CDP_GATEWAY_PORT=9888
# BADCASE_BRIDGE_TUNNEL_PORT=9889
# BADCASE_BRIDGE_INTERNAL_KEY=
# BADCASE_CDP_ROUTE_TTL_SEC=600
# 隧道公网地址覆盖（默认按请求域自动推导 wss://<同域>/api/local-proxy/tunnel）
# BADCASE_TUNNEL_URL=
# 通道 ensure 等待秒数（前端被卡片唤起拉起代理的时间窗）
# CDP_CHANNEL_WAIT_SEC=20
# 显式私网域名标记（逗号分隔；域名解析为私网 IP 时自动识别，此项用于解析不通的内网域名）
# CDP_PRIVATE_HOSTS=
# 客户端（go 代理）侧：企业 HTTPS 检查（MITM）环境注入根证书 / 仅环回调试跳过校验
# BADCASE_TUNNEL_CA=
# BADCASE_TUNNEL_INSECURE=

# Cloud sandbox (optional)
SANDBOX_REMOTE_URL=
SANDBOX_REMOTE_TOKEN=
SANDBOX_TENANT_ID=
