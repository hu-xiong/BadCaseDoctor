MAIL_DEFAULT_SENDER=h2629258027@163.com

# 应用密钥
SECRET_KEY=your-secret-key-here

# 智谱GLM配置
ZHIPU_API_KEY=b6185f3bac97489da843602537da8cec.cFBNLM2wRxb8lBwJ
ZHIPU_MODEL=glm-4-flash
ZHIPU_MODEL_REASONING=glm-5

# 豆包/Ark embedding（grep 向量检索用）
DOUBAO_API_KEY=ark-6f0fc40a-81c0-445e-b7d6-1e15312bb9a6-c3fd0

# =========================
# 云端沙盒（llm-sandbox 云端服务）配置
# =========================
# 让 Text2SQL 沙箱执行优先走云端
SANDBOX_MODE=cloud

# 云端沙盒服务地址（你已在云端启动并开放 5000 端口）
SANDBOX_REMOTE_URL=http://117.72.33.38:5000

# 先跑通可留空；后续启用鉴权再填
SANDBOX_REMOTE_TOKEN=
SANDBOX_TENANT_ID=default

# 云端执行超时/轮询间隔
SANDBOX_REMOTE_TIMEOUT_S=30
SANDBOX_REMOTE_POLL_INTERVAL_S=0.5

# 本地侧：Text2SQL 执行模式（direct 或 sandbox）
TEXT2SQL_EXECUTION_MODE=sandbox

# ReAct / Agent：打印各阶段耗时（终端 grep [PERF]）；开启后 app.py 会关闭热重载便于稳定测时
PERF_LOG=1
REACT_MAIN_LOOP_LOG=1

# ReAct P0/P1（见 agents/react_simplified.py 模块顶部说明）
REACT_SKIP_THINK_HINT=1
# [REACT_PROMPT] 可读 prompt 日志：默认随 PERF_LOG=1 开启；设 REACT_PROMPT_LOG=0 可关
# LLM_LOG_PROMPTS=1          # 额外打印底层 API JSON（messages/tools），较刷屏
# LLM_LOG_RESPONSE=1
# LLM_PROMPT_LOG_PATH=logs/llm_io.jsonl
REACT_TOOL_DESC_MAX_CHARS=1200
REACT_TOOLS_INTENT_MODEL=qwen-turbo
REACT_TOOLS_INTENT_TIMEOUT=6
REACT_THINK_PROMPT_COMPACT=0
REACT_TODO_MAX_STEPS=4
# decision_observe 改用 summary_nl 直出，省略 ui_observe_summary LLM（通常省数秒～数十秒）
REACT_OBSERVE_UI_LLM=1
REACT_OBSERVE_UI_PARALLEL=1

# observe 流式（仅 Qwen chat_stream 支持 max_tokens 时生效）；裁剪 prompt 内 observation/context 默认开启
REACT_OBSERVE_MAX_TOKENS=1024
REACT_OBSERVE_PROMPT_LIST_CAP=10
REACT_OBSERVE_PROMPT_STR_CHARS=320

# 流式 decide（非 FC）可选 max_tokens；FC 决策未单独设 REACT_DECIDE_FC_MAX_TOKENS 时会回落到该项
REACT_DECIDE_MAX_TOKENS=1024
REACT_DECIDE_PROMPT_SHRINK=0
REACT_DECIDE_PROMPT_LIST_CAP=10
REACT_DECIDE_PROMPT_STR_CHARS=320
# REACT_DECIDE_FC_MAX_TOKENS=1024

# 可选：同一引擎实例内 grep 成功结果缓存秒数（0=关默认）；短 TTL 可减负，数据刚变更时可能略旧
REACT_GREP_RESULT_CACHE_TTL=0

# modify 性能开关（仅优化速度，不改默认策略：Text2SQL 仍优先）
MODIFY_LOOKUP_ORM_FIRST=0
MODIFY_ORIGINAL_DATA_ORM_FIRST=0
MODIFY_SANDBOX_DIRECT_SQL=1
TEXT2SQL_SQL_CACHE_TTL=30
TEXT2SQL_SQL_CACHE_MAX=128

# 以下 REACT_DECIDE_* / FC 相关：当前 Agent 仅 ``_run_unified_xml_stream``（三段式），主路径不读这些项，可删可留作别处实验
REACT_DECIDE_XML_FALLBACK=1
REACT_DECIDE_FUNCTION_CALL=0
